<script>
var csrSliderData = {"ajaxUrl":"https:\/\/coresight.com\/wp-admin\/admin-ajax.php","nonce":"eddccbfccb","postIds":{"video":0,"webinar":0,"infographic":0,"podcast":0}};
</script>
<script>
	jQuery(document).ready(function ($) {
		// Popover js
		$('.coresight-info-icon').each(function() {
			var targetContentId = $(this).data('popover-id');
			$(this).popover({
				html: true,
				content: function() {
					return $(targetContentId).prop('outerHTML');
				},
				trigger: 'click',
				boundary: 'window'
			});
		});

		jQuery(document).on('click', function(e) {
			var $target = jQuery(e.target);
			
			// If the click is NOT inside a popover and NOT on the trigger icon, hide it
			if ($target.closest('.popover').length === 0 && $target.closest('.coresight-info-icon').length === 0) {
				jQuery('.coresight-info-icon').popover('hide');
			}
		});

		$('.coresight-share-trigger').each(function() {
			var $trigger = $(this);
			var tabId = $trigger.attr('id').replace('coresight-share-popover-', '');
			var $content = $('#coresight-share-popover-content-' + tabId);
			var contentHTML = $('#coresight-share-popover-content-' + tabId).prop('outerHTML');

			$trigger.popover({
				html: true,
				content: contentHTML,
				boundary: 'window',
				placement: 'auto',
				sanitize: false
			});
		});

		$('body').on('click', function (e) {
			$('.coresight-share-trigger').each(function () {
				if (!$(this).is(e.target) && $(this).has(e.target).length === 0 && $('.popover').has(e.target).length === 0) {
					$(this).popover('hide');
				}
			});
		});
		function checkTocVisibility() {
			var $toc = $('#coresight-floating-toc');
			var $tabs = $('.tab-controls .tab-btn');
			var tabsExist = $tabs.length > 0;
			if ($(window).width() <= 767) {
				$toc.css('display', 'none');
				return;
			}
			if (!tabsExist) {
				$toc.css('display', 'block');
			} else {
				var isReportActive = $('.tab-controls .tab-btn[data-target="report"]').hasClass('active');
				if (isReportActive) {
					$toc.css('display', 'block');
				} else {
					$toc.css('display', 'none');
				}
			}
		}
		checkTocVisibility();
		var tocResizeTimer;
		$(window).on('resize', function() {
			clearTimeout(tocResizeTimer);
			tocResizeTimer = setTimeout(function() { checkTocVisibility(); }, 150);
		});
		$('.tab-controls .tab-btn').on('click', function(e) {
            e.preventDefault();
            var target = $(this).data('target');
			$('#coresight-floating-toc').css('display', 'none');
			if (history.pushState) {
				history.pushState(null, null, '#' + target);
			} else {
				window.location.hash = '#' + target;
			}

			if(document.getElementById(`latest-research-glide-${target}`)) {
				setTimeout(function () {
						initGlideById(`latest-research-glide-${target}`);
				}, 100);
			}
            // Activate selected tab style
            $('.tab-controls .tab-btn').removeClass('active').attr('aria-selected', 'false');
            $(this).addClass('active').attr('aria-selected', 'true');
            
            // Toggle Display for Correct Pre-Rendered Header Block
            $('.coresight-single-header-tab').hide();
            $('#header-wrapper-' + target).fadeIn(250);

            // Toggle Main Body Content
            $('.tab-panel').removeClass('active').hide();
            $('#tab-panel-' + target).addClass('active').fadeIn(250);
            
            // Toggle Related content sliders
            $('[id^="csr-related-"]').hide();
            if (target === 'report') {
                $('#csr-related-reports-default').fadeIn(250);
				if($(window).width() >= 768){
					$('#coresight-floating-toc').css('display', 'block');
				}
            } else {
                var $slider = $('#csr-related-' + target + 's-slider');
                if ($slider.length && !$slider.children().length && typeof csrSliderData !== 'undefined' && csrSliderData.postIds[target]) {
                    $.post(csrSliderData.ajaxUrl, {
                        action:     'csr_related_slider',
                        nonce:      csrSliderData.nonce,
                        post_id:    csrSliderData.postIds[target],
                        media_type: target,
                    }, function(resp) {
                        if (resp.success && resp.data.html) {
                            $slider.html(resp.data.html).fadeIn(250);
                            setTimeout(function() { initGlideById('latest-research-glide-' + target); }, 100);
                        }
                    });
                } else {
                    $slider.fadeIn(250);
                }
            }
        });
		initGlideById(`latest-research-glide-report`);
		var currentHash = window.location.hash.substring(1);
		if (currentHash) {
			var $targetTab = $('.tab-controls .tab-btn[data-target="' + currentHash + '"]');
			if ($targetTab.length) {
				$targetTab.trigger('click');
			}
		}

		// --- NEW: 3. HANDLE BROWSER BACK/FORWARD BUTTONS ---
		$(window).on('hashchange', function() {
			var newHash = window.location.hash.substring(1);
			if (newHash) {
				var $targetTab = $('.tab-controls .tab-btn[data-target="' + newHash + '"]');
				if ($targetTab.length && !$targetTab.hasClass('active')) {
					$targetTab.trigger('click');
				}
			} else {
				$('.tab-controls .tab-btn').first().trigger('click');
			}
		});
		$('.custom-audio-player').each(function() {
			const $player = $(this);
			
			// We need the raw DOM element for the HTML5 Audio API methods
			const audio = $player.find('.audio-element')[0];
			
			// jQuery objects for UI elements
			const $playPauseBtn = $player.find('.play-pause-btn');
			const $playIcon = $player.find('.play-icon');
			const $pauseIcon = $player.find('.pause-icon');
			const $seekBar = $player.find('.seek-bar');
			const $progressFill = $player.find('.progress-fill');
			const $currentTimeEl = $player.find('.current-time');
			const $durationEl = $player.find('.duration-time');
			const $muteBtn = $player.find('.mute-btn');
			const $volumeOnIcon = $player.find('.volume-on-icon');
        	const $volumeOffIcon = $player.find('.volume-off-icon');
			const $skipBackBtn = $player.find('.skip-back-btn');
			const $skipForwardBtn = $player.find('.skip-forward-btn');
			const $speedBtn = $player.find('.speed-btn');

			// Helper: Format Time (seconds to MM:SS)
			function formatTime(seconds) {
				if (isNaN(seconds)) return "00:00";
				const min = Math.floor(seconds / 60);
				const sec = Math.floor(seconds % 60);
				return `${min < 10 ? '0' + min : min}:${sec < 10 ? '0' + sec : sec}`;
			}

			// Load Metadata (Duration)
			$(audio).on('loadedmetadata', function() {
				$durationEl.text(formatTime(audio.duration));
				$seekBar.attr('max', audio.duration);
			});

			// Play / Pause
			$playPauseBtn.on('click', function() {
				if (audio.paused) {
					audio.play();
					$playIcon.hide();
					$pauseIcon.show();
				} else {
					audio.pause();
					$playIcon.show();
					$pauseIcon.hide();
				}
			});

			// Update Progress Bar as Audio Plays
			$(audio).on('timeupdate', function() {
				$seekBar.val(audio.currentTime);
				$currentTimeEl.text(formatTime(audio.currentTime));
				
				const percentage = (audio.currentTime / audio.duration) * 100;
				$progressFill.css('width', percentage + '%');
			});

			// Seek Bar Interaction
			$seekBar.on('input', function() {
				audio.currentTime = $(this).val();
			});

			// Skip Buttons (15 seconds)
			$skipBackBtn.on('click', function() {
				audio.currentTime = Math.max(0, audio.currentTime - 15);
			});

			$skipForwardBtn.on('click', function() {
				audio.currentTime = Math.min(audio.duration, audio.currentTime + 15);
			});

			// Mute / Unmute
			$muteBtn.on('click', function() {
				audio.muted = !audio.muted;
				
				if (audio.muted) {
					$volumeOnIcon.hide();
					$volumeOffIcon.show();
				} else {
					$volumeOnIcon.show();
					$volumeOffIcon.hide();
				}
			});

			// Speed Toggle (1x -> 1.25x -> 1.5x -> 2x -> 1x)
			const speeds = [1, 1.25, 1.5, 2];
			let currentSpeedIndex = 0;
			
			$speedBtn.on('click', function() {
				currentSpeedIndex = (currentSpeedIndex + 1) % speeds.length;
				audio.playbackRate = speeds[currentSpeedIndex];
				$(this).text(speeds[currentSpeedIndex] + 'x');
			});
			
			// Reset icon when audio ends
			$(audio).on('ended', function() {
				$playIcon.show();
				$pauseIcon.hide();
				$seekBar.val(0);
				$progressFill.css('width', '0%');
			});

			// $(audio).on('waiting', function() {
			// 	$player.css('opacity', '0.6');
			// 	$player.css('pointer-events', 'none');
			// });

			// // Triggered when enough audio is downloaded to resume playing
			$(audio).on('playing canplay', function() {
				$player.css('opacity', '1');
				$player.css('pointer-events', 'auto');
			});
		});
	});
</script>
	<div id="to-top">
