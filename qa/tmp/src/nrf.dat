",{\"name\":\"datePublished\",\"content\":\"2024-12-05 00:00\"}],[\"$\",\"link\",\"14\",{\"rel\":\"canonical\",\"href\":\"https://nrf.com/research/2024-consumer-returns-retail-industry\"}],[\"$\",\"meta\",\"15\",{\"property\":\"og:title\",\"content\":\"NRF and Happy Returns 2024 Consumer Returns in the Retail Industry | NRF\"}],[\"$\",\"meta\",\"16\",{\"property\":\"og:url\",\"content\":\"https://nrf.com/research/2024-consumer-returns-retail-industry\"}],[\"$\",\"meta\",\"17\",{\"property\":\"og:image\",\"content\":\"https://a-us.storyblok.com/f/1020215/300x61/dfd396fe44/nrf-logo.svg\"}],[\"$\",\"meta\",\"18\",{\"property\":\"og:type\",\"content\":\"website\"}],[\"$\",\"meta\",\"19\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"20\",{\"name\":\"twitter:title\",\"content\":\"NRF and Happy Returns 2024 Consumer Returns in the Retail Industry | NRF\"}],[\"$\",\"meta\",\"21\",{\"name\":\"twitter:image\",\"content\":\"https://a-us.storyblok.com/f/1020215/300x61/dfd396fe44/nrf-logo.svg\"}]]\n36:null\n5c:T5a2,[{\"@context\":\"https://schema.org\",\"@type\":\"Report\",\"@id\":\"https://nrf.com/nrfcom/research/2024-consumer-returns-retail-industry\",\"headline\":\"NRF and Happy Returns 2024 Consumer Returns in the Retail Industry\",\"datePublished\":\"2024-12-05 00:00\",\"dateModified\":\"2024-12-05 00:00\",\"publisher\":{\"@type\":\"Organization\",\"@id\":\"https://nrf.com/#organization\"},\"image\":\"https://a-us.storyblok.com/f/1020215/300x61/dfd396fe44/nrf-logo.svg\",\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://nrf.com/nrfcom/research/2024-consumer-returns-retail-industry\",\"headline\":\"NRF and Happy Returns 2024 Consumer Returns in the Retail Industry\",\"description\":\"\",\"about\":\"Industry Research, Return Fraud\",\"image\":\"https://a-us.storyblok.com/f/1020215/300x61/dfd396fe44/nrf-logo.svg\",\"datePublished\":\"2024-12-05 00:00\",\"dateModified\":\"2024-12-13T19:40:32.342Z\",\"author\":{\"@type\":\"Organization\",\"@id\":\"https://nrf.com/#organization\"},\"publisher\":{\"@type\":\"Organization\",\"@id\":\"https://nrf.com/#organization\"},\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://nrf.com/nrfcom/research/2024-consumer-returns-retail-industry\"}}},{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://nrf.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"NRF and Happy Returns 2024 Consumer Returns in the Retail Industry\",\"item\":\"https://nrf.com/research/2024-consumer-returns-retail-industry\"}]}]20:[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$5c\"}}],\"$L5d\"]\n5e:I[55154,[\"4935\",\"$2\",\"7596\",\"$6\",\"1614\",\"$7\",\"586\",\"$8\",\"226\",\"$9\",\"6355\",\"$3\",\"1413\",\"$a\",\"2348\",\"$b\",\"6094\",\"$c\",\"8974\",\"$d\"],\"ArticleView\"]\n5d:[[\"$\",\"$L39\",null,{}],[\"$\",\"$L5e\",null,{\"story\":{\"_uid\":\"d0f440e2-b0a4-4ee0-a7d2-35a89dc2a31f\",\"body\":[{\"gap\":\"30\",\"_uid\":\"e637a661-616f-4978-81eb-f688efc5e116\",\"text\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"To understand the shifting landscape that is retail returns, NRF and Happy Returns, a UPS company, explored both consumer and retailer perspectives and priorities for the returns experience in 2024 Consumer Returns in the Retail Industry. The report explores the impact of returns for the retail industry, consumer expectations for returns, retailers’ priorities and strategies for returns, the challenge of fraudulent and abusive returns practices and the vision for returns in 2025. Key findings include: \",\"type\":\"text\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Total returns for the retail industry are projected to reach $890 billion in 2024.\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"76% of consumers consider free returns a key factor in deciding where to shop.\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"More than two-thirds of retailers surveyed say they are prioritizing upgrading their returns capabilities within the next six months.\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"A majority (93%) of retailers said retail fraud and other exploitive behavior is a significant issue for their business.\",\"type\":\"text\"}]}]}]}]},\"component\":\"quote\",\"quoteText\":\"\",\"memberOnly\":false,\"paddingTop\":\"\",\"quoteStyle\":\"excerpt\",\"textAround\":true,\"inverseSide\":true,\"quoteAuthor\":\"\",\"verticalGap\":\"10\",\"quoteExcerpt\":{\"type\":\"doc\",\"content\":[{\"type\":\"heading\",\"attrs\":{\"level\":3},\"content\":[{\"text\":\"2024 Consumer Returns in the Retail Industry\",\"type\":\"text\",\"marks\":[{\"type\":\"styled\",\"attrs\":{\"class\":\"h6\"}},{\"type\":\"textStyle\",\"attrs\":{\"color\":\"#FFFFFF\"}}]}]},{\"type\":\"blok\",\"attrs\":{\"id\":\"5f68e7ff-5950-4a42-a0e6-a757e8d82b2f\",\"body\":[{\"_uid\":\"i-1fd26d79-ae10-4621-91a4-00aa21733f0f\",\"link\":{\"id\":\"\",\"url\":\"https://nrf.com/api/asset/storyblok?request=vHoxpw%2F8Xp5SVLhzLYGw4NrFm4%2FzhUlvygwuFbnjguRa2YQi%2BqJqgZ6T31ZQFKZQRj7G5L5B0z%2Bh2VwCTEwSb3EL07I7cQ4NW6NUB9d4IuSPQHqaMIIIU1w%2BPklbx2sSFwEaGAKJypF%2B1HYVMl3zSsIs3haaIqed7Ifc1807bbcE6ffXLy0uyzfDJd4%2B%7C3f2q7rhCv7Es0SwR\",\"linktype\":\"asset\",\"fieldtype\":\"multilink\",\"cached_url\":\"https://nrf.com/api/asset/storyblok?request=vL7U7UTVN04FuyUcSTRmNV4gmQMU1%2BcJoXKsoaBgIBteWGHR5c731zT7toBQVidjoO%2BjzlcOZ4qCU4%2BtOqQLGQMj4YBw0esqW4XSq4cc8okrlX5R58M%2FvLbZJnVR14IewG0RoKO1PQ32hqPijcylRXLEhAHYK%2Fp6AFXj7p8ANEjQKDQ35c33R0ilK6Qc%7C1KPP06BczDlUsp7I\"},\"text\":\"DOWNLOAD REPORT\",\"align\":\"alignContentCenter