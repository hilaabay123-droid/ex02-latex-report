\nflex-direction:column;\n}\n\n#search404 {\nmax-width:450px;\nmargin:20px 0 45px 0;\n}\n\n#content404 \u003e [class*=\"RichText\"] \u003e h1 {\ndisplay:block;\nfont-family:poppins;\nfont-size:1.5rem;\n}\n\n\n/** PREVENT ORPHAN WORDS **/\n#content404 \u003e [class*=\"RichText\"] \u003e :is(h1, h2, h3, h4, h5, h6, p) {text-wrap:pretty;}\n\n\n/** HELPFUL LINKS STYLING **/\n.links404 \u003e ul {\nlist-style-type:none;\npadding:0;\ncolumn-count:2;\ncolumn-gap:30px;\n}\n\n.links404 \u003e ul \u003e li {margin-bottom:5px;}\n\n.links404 \u003e ul \u003e li:nth-child(1) \u003e p {margin-block-start:0;}\n\n\n/** IMAGE HALF STYLING **/\n#image404 {\nmargin-top:35px;\nborder-radius:20px;\n}\n\n#image404 \u003e picture {aspect-ratio:1.5/1;}\n\n#image404 \u003e picture \u003e img {\ndisplay:none;\nwidth:100% !important;\nborder-radius:20px !important;\naspect-ratio:1.5/1 !important;\nobject-fit:cover;\nobject-position:left;\n}\n\n\n/** REMOVE BREADCRUMBS **/\n[class*=\"Breadcrumbs\"] {display:none;}\n\n\n/** RESPONSIVE ADJUSTMENTS **/\n@media (max-width:992px) {\n#nrf404 {margin-top:15px; padding:1rem 20px;}\n#image404 {margin-top:unset;}\n}\n\n@media (max-width:480px) {\n.links404 \u003e ul {column-count:1;}\n}\n\n4c:[\"$\",\"div\",\"47c02a0e-d968-4877-a3f9-5b45acbb2b97\",{\"className\":\"Embed_embedContainer__xGGqX\",\"style\":{\"width\":\"$undefined\",\"minWidth\":\"$undefined\",\"maxWidth\":\"$undefined\",\"height\":\"$undefined\",\"minHeight\":\"$undefined\",\"maxHeight\":\"$undefined\",\"marginLeft\":\"$undefined\",\"marginRight\":\"$undefined\",\"marginTop\":\"$undefined\",\"marginBottom\":\"$undefined\",\"paddingLeft\":\"$undefined\",\"paddingRight\":\"$undefined\",\"paddingTop\":\"$undefined\",\"paddingBottom\":\"$undefined\"},\"children\":[[\"$\",\"style\",\"0\",{\"type\":\"text/css\",\"dangerouslySetInnerHTML\":{\"__html\":\"$57\"},\"children\":\"$undefined\"}],\"\\n\"]}]\n4e:[\"$\",\"$L4d\",\"link-d3522990-03b3-4dee-bcfd-058f4610da57-2\",{\"link\":{\"url\":{\"id\":\"