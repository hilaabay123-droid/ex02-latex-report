nk rel="modulepreload" href="https://shopify-assets.shopifycdn.com/shopifycloud/shopify-dev/production/assets/PropertyHeader-BH3YEEoT.js"/><link rel="modulepreload" href="https://shopify-assets.shopifycdn.com/shopifycloud/shopify-dev/production/assets/DownloadMarkdownContainer-Dww_GJ_6.js"/><link rel="modulepreload" href="https://shopify-assets.shopifycdn.com/shopifycloud/shopify-dev/production/assets/getCanonicalPath-CdnMua-7.js"/><link rel="modulepreload" href="https://shopify-assets.shopifycdn.com/shopifycloud/shopify-dev/production/assets/CodeBlock-DXAYhuEl.js"/><link rel="modulepreload" href="https://shopify-assets.shopifycdn.com/shopifycloud/shopify-dev/production/assets/Hero-DIPGbWMW.js"/><link rel="modulepreload" href="https://shopify-assets.shopifycdn.com/shopifycloud/shopify-dev/production/assets/utils-CoW0Zmst.js"/><link rel="modulepreload" href="https://shopify-assets.shopifycdn.com/shopifycloud/shopify-dev/production/assets/DownloadMarkdown-gOplLRN5.js"/><link rel="modulepreload" href="https://shopify-assets.shopifycdn.com/shopifycloud/shopify-dev/production/assets/LiquidExample-DGr8EAtv.js"/><link rel="modulepreload" href="https://shopify-assets.shopifycdn.com/shopifycloud/shopify-dev/production/assets/sortValidAndDeprecated-BS-tlGgp.js"/><link rel="modulepreload" href="https://shopify-assets.shopifycdn.com/shopifycloud/shopify-dev/production/assets/useIntersectionObserver-BCzWVAql.js"/><link rel="modulepreload" href="https://shopify-assets.shopifycdn.com/shopifycloud/shopify-dev/production/assets/LegacyHydrogenBanner-CQjGxBNY.js"/><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Corporation","@id":"https://www.shopify.com/#organization","name":"Shopify","legalName":"Shopify Inc.","url":"https://www.shopify.com/","logo":"https://cdn.shopify.com/shopifycloud/brochure/assets/brand-assets/shopify-logo-primary-logo-456baa801ee66a0a435671082365958316831c9960c480451dd0330bcdae304f.svg","sameAs":["https://en.wikipedia.org/wiki/Shopify","https://github.com/Shopify","https://www.facebook.com/shopify/","https://www.instagram.com/shopify/","https://www.linkedin.com/company/shopify/","https://www.youtube.com/shopify","https://x.com/Shopify"]},{"@type":"WebSite","@id":"https://shopify.dev/#website","name":"Shopify Dev Docs","url":"https://shopify.dev","inLanguage":"en","publisher":{"@id":"https://www.shopify.com/#organization"}}]}</script><script>
              self.getThemeMode = () => {
                for (const cookie of document.cookie.split(';')) {
                  const [key, value] = cookie
                    .trim()
                    .split('=')
                    .map((value) => decodeURIComponent(value));

                  if (key === 'theme_mode') {
                    if (value === 'ThemeMode-dark') return 'dark';
                    if (value === 'ThemeMode-default') return 'light';
                  }
                }

                if (matchMedia('(prefers-color-scheme: dark)').matches) return 'dark';
                return 'light';
              };

              self.setThemeMode = (mode) => {
                const cookieValue = mode === 'dark' ? 'ThemeMode-dark' : 'ThemeMode-default';
                document.cookie = `theme_mode=${cookieValue}; path=/`;
              };

              try {
                if (getThemeMode() === 'dark') {
                  document.documentElement.classList.remove('Mode-Light');
                  document.documentElement.classList.add('Mode-Dark');
                }
              } catch (_) {}

              
// The reader's own sidebar choice, stamped before first paint so
// CSS can apply it to markup that was rendered for someone else.
// Loaders seed the state into pages the page cache keys on this
// cookie, but /changelog, /blog, /release-notes and /internal
// bypass that cache entirely, and every response downstream is public and
// does not vary on it -- so the stamp, not the markup, is what
// makes first paint right for everyone. NavigationCollapsible
// keeps it in step from hydration on; nothing else writes it.
//
// Stamped for every reader, the no-cookie default included: the
// attribute's presence is what tells CSS to trust the stamp over
// the rendered state, so a reader who has never touched the
// toggle needs one too -- otherwise a shared document rendered
// as expanded paints an open sidebar at them and shuts it again
// on mount. Without it (no JavaScript, or this threw) the
// rendered state paints, which is the best available answer.
try {
  const sidebar = document.cookie.match(
    /(?:^|;\s*)sidebar_collapse_status=(collapsed|expanded)(?:;|$)/,
  );
  document.documentElement.dataset.sidebarPref = sidebar
    ? sidebar[1]
    : 'default';
} catch (_) {}
